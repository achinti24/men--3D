# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored — never commit real secrets.

# ---------------------------------------------------------------------------
# Frontend (Vite) — must be prefixed with VITE_ to be exposed to the browser.
# Never put a secret behind a VITE_ variable; it ships in the client bundle.
# ---------------------------------------------------------------------------

# Both optional in local dev — see src/config/constants.ts. Without them,
# the frontend calls the API via a relative `/api` path (proxied to the
# backend by vite.config.ts, same origin as the page) and assumes its own
# public URL is wherever it's currently being served from. Set these
# explicitly only for production, where the frontend and API may live on
# completely different domains.
# VITE_PUBLIC_APP_URL=https://app.example.com
# VITE_API_BASE_URL=https://api.example.com/api

# ---------------------------------------------------------------------------
# Backend (Phase 2+) — server-side only, never exposed to the client.
# ---------------------------------------------------------------------------

# Port the Express API listens on.
PORT=3000

# Postgres connection string for the relational database.
DATABASE_URL=

# Secret used to sign/verify JWT access + refresh tokens. Generate with
# `openssl rand -hex 32`. Must be at least 16 characters.
AUTH_SECRET=

# Public base URL of the FRONTEND, read server-side to build the QR code
# target (`${PUBLIC_APP_URL}/menu/:slug`) — this one must always be a real,
# externally-reachable value (it's embedded as literal text in the QR image),
# never a relative path.
PUBLIC_APP_URL=http://localhost:5173

# Object storage (Phase 3 ships a local-disk StorageService for development —
# see backend/src/lib/storage/. These are reserved for a future cloud
# provider swap: Supabase Storage / S3 / R2 / Cloudinary. Only the keys the
# chosen provider needs apply.
STORAGE_URL=
STORAGE_KEY=
STORAGE_BUCKET=

# Comma-separated list of origins allowed to call the API directly (CORS).
# With the Vite dev proxy, the browser normally never calls the API
# cross-origin — this only matters for direct API access (curl, Postman,
# another client) or before the proxy is in place.
ALLOWED_ORIGINS=http://localhost:5173
