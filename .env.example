# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored — never commit real secrets.

# ---------------------------------------------------------------------------
# Frontend (Vite) — must be prefixed with VITE_ to be exposed to the browser.
# Never put a secret behind a VITE_ variable; it ships in the client bundle.
# ---------------------------------------------------------------------------

# Public base URL of this app, used to build QR codes and shareable menu links.
VITE_PUBLIC_APP_URL=http://localhost:5173

# Base URL of the backend API (introduced in Phase 2).
VITE_API_BASE_URL=http://localhost:3000/api

# ---------------------------------------------------------------------------
# Backend (Phase 2+) — server-side only, never exposed to the client.
# ---------------------------------------------------------------------------

# Postgres/MySQL connection string for the relational database.
DATABASE_URL=

# Secret used to sign/verify auth tokens (JWT or session secret).
AUTH_SECRET=

# Object storage (Supabase Storage / S3 / R2 / Cloudinary) for images and
# GLB/GLTF 3D models. Only the keys the chosen provider needs apply.
STORAGE_URL=
STORAGE_KEY=
STORAGE_BUCKET=

# Comma-separated list of origins allowed to call the API (CORS).
ALLOWED_ORIGINS=http://localhost:5173
